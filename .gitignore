.DS_Store

# Keep the selected reproducible case; do not accidentally add 18 GB of history.
/runs/*
!/runs/reconnect-contact-oracle/
!/runs/reconnect-contact-spatial/
!/runs/reconnect-affine-shear-spatial/
/runs/reconnect-affine-shear-spatial/*
